rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- الدوال المساعدة ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'eball8361@gmail.com';
    }

    function isBanned() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('isBanned', false) == true;
    }

    function validText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isBlockedBy(otherUid) {
      return exists(
        /databases/$(database)/documents/blocks/$(otherUid + '_' + request.auth.uid)
      );
    }

    function convMembers(convId) {
      return get(
        /databases/$(database)/documents/conversations/$(convId)
      ).data.members;
    }

    function otherOf(members) {
      return members[0] == request.auth.uid
        ? members[1]
        : members[0];
    }

    // ---------- 1. ملفات المستخدمين العامة ----------
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && !('email' in request.resource.data)
        && request.resource.data.role == 'user'
        && request.resource.data.isVerified == false
        && request.resource.data.isBanned == false
        && request.resource.data.followersCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.postsCount == 0
        && request.resource.data.accountType in ['public', 'private']
        && validText(request.resource.data.displayName, 1, 50)
        && validText(request.resource.data.username, 3, 30);

      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'role',
            'isVerified',
            'isBanned',
            'followersCount',
            'followingCount',
            'postsCount',
            'createdAt'
          ])
        && (!('email' in request.resource.data)
            || ('email' in resource.data))
        && validText(request.resource.data.displayName, 1, 50)
        && (!('bio' in request.resource.data)
            || validText(request.resource.data.bio, 0, 150))
        && (!('accountType' in request.resource.data)
            || request.resource.data.accountType in ['public', 'private']);

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- 2. البيانات الخاصة ----------
    match /userPrivate/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
        && validText(request.resource.data.email, 3, 254)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- 3. مفاتيح التشفير العامة ----------
    match /publicKeys/{uid} {
      allow read: if signedIn();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'keyId',
          'publicKey',
          'updatedAt'
        ])
        && validText(request.resource.data.keyId, 8, 64)
        && validText(request.resource.data.publicKey, 40, 400)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid) || isAdmin();
    }

    // نسخة المفتاح الخاص المشفرة
    match /keyBackups/{uid} {
      allow read, delete: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'keyId',
          'salt',
          'iv',
          'ciphertext',
          'iterations',
          'updatedAt'
        ])
        && validText(request.resource.data.keyId, 8, 64)
        && validText(request.resource.data.salt, 16, 64)
        && validText(request.resource.data.iv, 8, 64)
        && validText(request.resource.data.ciphertext, 40, 2000)
        && request.resource.data.iterations is int
        && request.resource.data.iterations >= 100000
        && request.resource.data.iterations <= 2000000
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- 4. المنشورات ----------
    match /posts/{postId} {
      allow read: if true;

      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'content',
          'mediaUrl',
          'mediaType',
          'likesCount',
          'commentsCount',
          'createdAt',
          'repostOfId',
          'repostOfAuthorId'
        ])
        && validText(request.resource.data.authorName, 1, 50)
        && validText(request.resource.data.content, 0, 2000)
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.createdAt == request.time
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && (!('repostOfId' in request.resource.data)
            || validText(request.resource.data.repostOfId, 1, 100))
        && (!('repostOfAuthorId' in request.resource.data)
            || validText(request.resource.data.repostOfAuthorId, 1, 100))
        && (!('mediaUrl' in request.resource.data)
            || request.resource.data.mediaUrl == ''
            || request.resource.data.mediaUrl.matches(
              'https://res\\.cloudinary\\.com/.*'
            ))
        && (!('mediaType' in request.resource.data)
            || request.resource.data.mediaType in ['image', 'video'])
        && (
          request.resource.data.content.size() > 0
          || (
            'mediaUrl' in request.resource.data
            && request.resource.data.mediaUrl != ''
          )
        );

      allow update: if signedIn() && (
        (
          request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['content'])
          && validText(request.resource.data.content, 0, 2000)
        )
        || isAdmin()
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likesCount'])
          && request.resource.data.likesCount >= 0
          && math.abs(
            request.resource.data.likesCount - resource.data.likesCount
          ) == 1
        )
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount >= 0
          && math.abs(
            request.resource.data.commentsCount - resource.data.commentsCount
          ) == 1
        )
      );

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
        );
    }

    // ---------- 5. القصص ----------
    match /stories/{storyId} {
      allow read: if signedIn();

      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'mediaUrl',
          'mediaType',
          'caption',
          'createdAt'
        ])
        && validText(request.resource.data.authorName, 1, 50)
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.matches(
          'https://res\\.cloudinary\\.com/.*'
        )
        && request.resource.data.mediaType in ['image', 'video']
        && (!('caption' in request.resource.data)
            || validText(request.resource.data.caption, 0, 200))
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
        );
    }

    // ---------- 5-ب. مشاهدات القصص والتفاعل معها ----------
    // وثيقة لكل مشاهد: storyViews/{storyId}_{viewerId}
    match /storyViews/{viewId} {
      // قراءة وثيقة واحدة: المشاهد صاحب المعرّف، أو صاحب القصة
      allow get: if signedIn()
        && (
          viewId.matches('^.+_' + request.auth.uid + '$')
          || resource.data.authorId == request.auth.uid
        );

      // قائمة المشاهدين: لصاحب القصة، أو المشاهد لوثائقه فقط
      allow list: if signedIn()
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.viewerId == request.auth.uid
        );

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'storyId',
          'authorId',
          'viewerId',
          'liked',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'storyId',
          'authorId',
          'viewerId',
          'liked',
          'createdAt'
        ])
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.authorId != request.auth.uid
        && viewId == request.resource.data.storyId + '_' + request.auth.uid
        && request.resource.data.liked == false
        && request.resource.data.createdAt == request.time
        && exists(
          /databases/$(database)/documents/stories/$(request.resource.data.storyId)
        )
        && get(
          /databases/$(database)/documents/stories/$(request.resource.data.storyId)
        ).data.authorId == request.resource.data.authorId;

      // المشاهد فقط يغيّر إعجابه أو رده
      allow update: if signedIn()
        && !isBanned()
        && resource.data.viewerId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['liked', 'reply', 'updatedAt'])
        && request.resource.data.liked is bool
        && (!('reply' in request.resource.data)
            || validText(request.resource.data.reply, 1, 200))
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && (
          resource.data.viewerId == request.auth.uid
          || resource.data.authorId == request.auth.uid
        );
    }

    // ---------- 6. الإعجابات ----------
    match /likes/{likeId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'postId',
          'userId',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        );

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 7. المتابعات ----------
    match /follows/{followId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'followerId',
          'followingId',
          'createdAt'
        ])
        && request.resource.data.followerId != request.resource.data.followingId
        && followId == request.resource.data.followerId
          + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time
        && (
          (
            request.auth.uid == request.resource.data.followerId
            && !isBlockedBy(request.resource.data.followingId)
            && get(
              /databases/$(database)/documents/users/$(request.resource.data.followingId)
            ).data.accountType == 'public'
          )
          ||
          (
            request.auth.uid == request.resource.data.followingId
            && exists(
              /databases/$(database)/documents/followRequests/$(followId)
            )
          )
        );

      allow delete: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );
    }

    // طلبات متابعة الحسابات الخاصة
    match /followRequests/{reqId} {
      allow read: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'followerId',
          'followingId',
          'createdAt'
        ])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid
        && reqId == request.auth.uid
          + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time
        && !isBlockedBy(request.resource.data.followingId)
        && get(
          /databases/$(database)/documents/users/$(request.resource.data.followingId)
        ).data.accountType == 'private';

      allow delete: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );
    }

    // ---------- 8. الحظر ----------
    match /blocks/{blockId} {
      allow read: if signedIn()
        && resource.data.blockerId == request.auth.uid;

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'blockerId',
          'blockedId',
          'createdAt'
        ])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.createdAt == request.time;

      allow delete: if signedIn()
        && resource.data.blockerId == request.auth.uid;
    }

    // ---------- 9. البلاغات ----------
    match /reports/{reportId} {
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'type',
          'targetId',
          'targetType',
          'reporterUid',
          'reason',
          'status',
          'createdAt'
        ])
        && request.resource.data.type in ['broken-link', 'abuse', 'spam', 'bug']
        && request.resource.data.targetType in [
          'episode',
          'comment',
          'post',
          'user',
          'app'
        ]
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validText(request.resource.data.targetId, 1, 200)
        && validText(request.resource.data.reason, 1, 500)
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // ---------- 10. المحادثات (محدث لدعم المجموعات) ----------
    match /conversations/{convId} {
      // السماح بالقراءة إذا كان المستخدم عضواً في المحادثة
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // السماح بإنشاء محادثة (فردية أو مجموعة)
      allow create: if signedIn()
        && !isBanned()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && (
          // حالة المحادثة الفردية (عضوين)
          (
            (!('type' in request.resource.data) || request.resource.data.type == 'direct')
            && request.resource.data.members.size() == 2
            && request.resource.data.members[0] < request.resource.data.members[1]
            && convId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
            && !isBlockedBy(otherOf(request.resource.data.members))
          )
          ||
          // حالة المجموعة (أكثر من عضوين)
          (
            request.resource.data.type == 'group'
            && request.resource.data.members.size() >= 2
            && validText(request.resource.data.name, 1, 50)
            && request.auth.uid in request.resource.data.admins
          )
        );

      // السماح بتحديث المحادثة (تحديث آخر رسالة، أو تغيير الثيم/الاسم من قبل الأدمن)
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && (
          // تحديث lastMessageAt فقط (عند إرسال رسالة جديدة)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt'])
            && request.resource.data.lastMessageAt == request.time
          )
          ||
          // تحديث الثيم (من قبل أي عضو في المحادثة)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme'])
          )
          ||
          // تحديث اسم المجموعة أو المشرفين (من قبل المشرف فقط)
          (
            resource.data.type == 'group'
            && request.auth.uid in resource.data.admins
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'admins'])
          )
        );

      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      // قواعد الرسائل داخل المحادثة
      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in convMembers(convId);

        allow create: if signedIn()
          && !isBanned()
          && request.auth.uid in convMembers(convId)
          && request.resource.data.keys().hasOnly(['senderId','ciphertext','iv','senderKeyId','recipientKeyId','createdAt','replyTo','reactions'])
          && request.resource.data.senderId == request.auth.uid
          && validText(request.resource.data.ciphertext, 1, 20000)
          && validText(request.resource.data.iv, 8, 64)
          && validText(request.resource.data.senderKeyId, 8, 64)
          && validText(request.resource.data.recipientKeyId, 8, 64)
          && request.resource.data.createdAt == request.time
          && (!('replyTo' in request.resource.data) || validText(request.resource.data.replyTo, 1, 100));

        // السماح بتحديث التفاعلات (الإيموجيات)
        allow update: if signedIn()
          && request.auth.uid in convMembers(convId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map;

        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ---------- 11. الحلقات والسيرفرات ----------
    match /episodes/{episodeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /servers/{serverId} {
        allow read: if true;

        allow create, update: if isAdmin()
          && validText(request.resource.data.name, 1, 50)
          && validText(request.resource.data.link, 1, 1000)
          && request.resource.data.link.matches('^https?://.*')
          && (!('quality' in request.resource.data)
              || validText(request.resource.data.quality, 1, 20));

        allow delete: if isAdmin();
      }
    }

    // ---------- 12. التعليقات ----------
    match /comments/{commentId} {
      allow read: if signedIn();

      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'postId',
          'authorId',
          'authorName',
          'authorPhotoURL',
          'content',
          'createdAt'
        ])
        && request.resource.data.postId is string
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        )
        && validText(request.resource.data.authorName, 1, 50)
        && validText(request.resource.data.content, 1, 500)
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
        );
    }

    // ---------- 13. الإشعارات ----------
    match /notifications/{nid} {
      allow read: if signedIn()
        && resource.data.toUid == request.auth.uid;

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'toUid',
          'fromUid',
          'fromName',
          'fromPhotoURL',
          'type',
          'text',
          'read',
          'createdAt',
          'postId'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.type in [
          'like',
          'comment',
          'follow',
          'request',
          'new_device'
        ]
        && validText(request.resource.data.fromName, 1, 50)
        && validText(request.resource.data.text, 0, 200)
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.type == 'new_device'
            && request.resource.data.toUid == request.auth.uid
          )
          ||
          (
            request.resource.data.type != 'new_device'
            && request.resource.data.toUid != request.auth.uid
          )
        )
        && (
          !('fromPhotoURL' in request.resource.data)
          || request.resource.data.fromPhotoURL is string
        )
        && (
          !('postId' in request.resource.data)
          || request.resource.data.postId is string
        );

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if signedIn()
        && resource.data.toUid == request.auth.uid;
    }

    // ---------- 14. الأجهزة المسجلة ----------
    match /userDevices/{uid}/items/{deviceId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && !isBanned()
        && validText(deviceId, 1, 100)
        && request.resource.data.keys().hasOnly([
          'label',
          'platform',
          'createdAt'
        ])
        && validText(request.resource.data.label, 1, 40)
        && request.resource.data.platform in ['android', 'web']
        && request.resource.data.createdAt == request.time;

      // منع تغيير بيانات الجهاز بعد تسجيله.
      allow update: if false;

      allow delete: if isOwner(uid);
    }

    // ---------- 15. المكتبة الشخصية ----------
    match /library/{itemId} {
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow create, update: if signedIn()
        && !isBanned()
        && request.resource.data.userId == request.auth.uid
        && itemId == request.auth.uid + '_'
          + request.resource.data.animeId;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 16. تقييمات الحلقات ----------
    match /episodeRatings/{ratingId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'episodeKey',
          'userId',
          'rating',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && ratingId == request.resource.data.episodeKey
          + '_' + request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 17. أنمي خاص ----------
    match /customAnime/{animeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 18. الإعلانات ----------
    match /announcements/{annId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- 19. سجل الإدارة ----------
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // أي مسار غير مذكور مرفوض افتراضياً.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
