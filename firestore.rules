rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- دوال مساعدة ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'eball8361@gmail.com';
    }
    function isBanned() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) && get(p).data.get('isBanned', false) == true;
    }
    function validText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function isBlockedBy(otherUid) {
      return exists(/databases/$(database)/documents/blocks/$(otherUid + '_' + request.auth.uid));
    }
    function convMembers(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data.members;
    }
    function otherOf(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    // ---------- 1. الملفات العامة ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && !('email' in request.resource.data)
        && request.resource.data.role == 'user'
        && request.resource.data.isVerified == false
        && request.resource.data.isBanned == false
        && request.resource.data.followersCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.postsCount == 0
        && request.resource.data.accountType in ['public', 'private']
        && validText(request.resource.data.displayName, 1, 50)
        && validText(request.resource.data.username, 3, 30);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'isVerified', 'isBanned',
                      'followersCount', 'followingCount', 'postsCount', 'createdAt'])
        && (!('email' in request.resource.data) || ('email' in resource.data))
        && validText(request.resource.data.displayName, 1, 50)
        && (!('bio' in request.resource.data)
            || validText(request.resource.data.bio, 0, 150))
        && (!('accountType' in request.resource.data)
            || request.resource.data.accountType in ['public', 'private']);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- 2. البيانات الخاصة (الإيميل) ----------
    match /userPrivate/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
        && validText(request.resource.data.email, 3, 254)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- 3. مفاتيح التشفير ----------
    match /publicKeys/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['keyId', 'publicKey', 'updatedAt'])
        && validText(request.resource.data.keyId, 8, 64)
        && validText(request.resource.data.publicKey, 40, 400)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /keyBackups/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['keyId', 'salt', 'iv', 'ciphertext', 'iterations', 'updatedAt'])
        && validText(request.resource.data.keyId, 8, 64)
        && validText(request.resource.data.salt, 16, 64)
        && validText(request.resource.data.iv, 8, 64)
        && validText(request.resource.data.ciphertext, 40, 2000)
        && request.resource.data.iterations is int
        && request.resource.data.iterations >= 100000
        && request.resource.data.iterations <= 2000000
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- 4. المنشورات ----------
    match /posts/{postId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly(
             ['authorId', 'authorName', 'authorPhotoURL', 'content',
              'mediaUrl', 'mediaType', 'likesCount', 'commentsCount', 'createdAt'])
        && validText(request.resource.data.authorName, 1, 50)
        && validText(request.resource.data.content, 0, 2000)
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.createdAt == request.time
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && (!('mediaUrl' in request.resource.data)
            || request.resource.data.mediaUrl == ''
            || request.resource.data.mediaUrl.matches('https://res\\.cloudinary\\.com/.*'))
        && (!('mediaType' in request.resource.data)
            || request.resource.data.mediaType in ['image', 'video'])
        && (request.resource.data.content.size() > 0
            || ('mediaUrl' in request.resource.data
                && request.resource.data.mediaUrl != ''));
      allow update: if signedIn() && (
        (request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content'])
          && validText(request.resource.data.content, 0, 2000))
        || isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
            && request.resource.data.likesCount >= 0
            && math.abs(request.resource.data.likesCount - resource.data.likesCount) == 1)
      );
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.authorId || isAdmin());
    }

    // ---------- 5. الإعجابات ----------
    match /likes/{likeId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly(['postId', 'userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- 6. المتابعة ----------
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.followerId != request.resource.data.followingId
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time
        && (
          (request.auth.uid == request.resource.data.followerId
            && !isBanned()
            && !isBlockedBy(request.resource.data.followingId)
            && get(/databases/$(database)/documents/users/$(request.resource.data.followingId))
                 .data.accountType == 'public')
          ||
          (request.auth.uid == request.resource.data.followingId
            && exists(/databases/$(database)/documents/followRequests/$(followId)))
        );
      allow delete: if signedIn()
        && (resource.data.followerId == request.auth.uid
            || resource.data.followingId == request.auth.uid);
    }

    match /followRequests/{reqId} {
      allow read: if signedIn()
        && (resource.data.followerId == request.auth.uid
            || resource.data.followingId == request.auth.uid);
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid
        && reqId == request.auth.uid + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time
        && !isBlockedBy(request.resource.data.followingId)
        && get(/databases/$(database)/documents/users/$(request.resource.data.followingId))
             .data.accountType == 'private';
      allow delete: if signedIn()
        && (resource.data.followerId == request.auth.uid
            || resource.data.followingId == request.auth.uid);
    }

    // ---------- 7. الحظر ----------
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['blockerId', 'blockedId', 'createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
    }

    // ---------- 8. البلاغات ----------
    match /reports/{reportId} {
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly(
             ['type', 'targetId', 'targetType', 'reporterUid', 'reason', 'status', 'createdAt'])
        && request.resource.data.type in ['broken-link', 'abuse', 'spam']
        && request.resource.data.targetType in ['episode', 'comment', 'post', 'user']
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validText(request.resource.data.targetId, 1, 200)
        && validText(request.resource.data.reason, 1, 500)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ---------- 9. المحادثات ----------
    match /conversations/{convId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'lastMessageAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && convId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && exists(/databases/$(database)/documents/users/$(otherOf(request.resource.data.members)))
        && !isBlockedBy(otherOf(request.resource.data.members))
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt'])
        && request.resource.data.lastMessageAt == request.time;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in convMembers(convId);
        allow create: if signedIn()
          && !isBanned()
          && request.auth.uid in convMembers(convId)
          && !isBlockedBy(otherOf(convMembers(convId)))
          && request.resource.data.keys().hasOnly(
               ['senderId', 'ciphertext', 'iv', 'senderKeyId', 'recipientKeyId', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && validText(request.resource.data.ciphertext, 1, 10000)
          && validText(request.resource.data.iv, 8, 64)
          && validText(request.resource.data.senderKeyId, 8, 64)
          && validText(request.resource.data.recipientKeyId, 8, 64)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ---------- 10. الحلقات والسيرفرات ----------
    match /episodes/{episodeId} {
      allow read: if true;
      allow write: if isAdmin();
      match /servers/{serverId} {
        allow read: if true;
        allow create, update: if isAdmin()
          && validText(request.resource.data.name, 1, 50)
          && validText(request.resource.data.link, 1, 1000)
          && request.resource.data.link.matches('^https?://.*')
          && (!('quality' in request.resource.data)
              || validText(request.resource.data.quality, 1, 20));
        allow delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
