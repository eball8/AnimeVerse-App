rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- الدوال المساعدة ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // المالك الأساسي: صاحب حجز اسم المستخدم animeverse_official
    // (لا يوجد أي إيميل داخل القواعد)
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/usernames/animeverse_official)
             .data.get('uid', '') == request.auth.uid;
    }

    function isBanned() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('isBanned', false) == true;
    }

    function validText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // حقول التسجيل الجديدة (كلها اختيارية للتوافق مع الحسابات القديمة وحسابات Google)
    function validSignupFields(d) {
      return (!('firstName' in d) || validText(d.firstName, 1, 25))
        && (!('lastName' in d) || validText(d.lastName, 1, 25))
        && (!('gender' in d) || d.gender in ['male', 'female', 'none'])
        && (!('birthDate' in d)
            || (d.birthDate is string
                && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('age' in d) || (d.age is int && d.age >= 13 && d.age <= 120));
    }

    // اسم المستخدم المكتوب في الملف الشخصي يجب أن يكون محجوزاً لصاحب الحساب
    // (الحجز يتم في نفس العملية الجماعية، لذلك نقرأ الحالة بعد التنفيذ)
    function ownsUsername(uname) {
      return uname is string
        && getAfter(/databases/$(database)/documents/usernames/$(uname))
             .data.get('uid', '') == request.auth.uid;
    }

    function isBlockedBy(otherUid) {
      return exists(
        /databases/$(database)/documents/blocks/$(otherUid + '_' + request.auth.uid)
      );
    }

    // حظر صارم ثنائي الاتجاه: أي من الطرفين حظر الآخر
    function isBlockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    function convData(convId) {
      return get(
        /databases/$(database)/documents/conversations/$(convId)
      ).data;
    }

    function isGroupConv(convId) {
      return convData(convId).get('type', 'direct') == 'group';
    }

    // المحادثات المباشرة فقط: يُرفض الإرسال فوراً عند وجود حظر بين الطرفين
    function notHardBlocked(convId) {
      return isGroupConv(convId)
        || !isBlockedEitherWay(
          request.auth.uid,
          otherOf(convData(convId).members)
        );
    }

    function convMembers(convId) {
      return get(
        /databases/$(database)/documents/conversations/$(convId)
      ).data.members;
    }

    function otherOf(members) {
      return members[0] == request.auth.uid
        ? members[1]
        : members[0];
    }

    // ---------- 1. ملفات المستخدمين العامة ----------
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && !('email' in request.resource.data)
        && request.resource.data.role == 'user'
        && request.resource.data.isVerified == false
        && request.resource.data.isBanned == false
        && request.resource.data.followersCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.postsCount == 0
        && request.resource.data.accountType in ['public', 'private']
        && validText(request.resource.data.displayName, 1, 50)
        && validText(request.resource.data.username, 3, 30)
        && ownsUsername(request.resource.data.username)
        && validSignupFields(request.resource.data);

      allow update: if (
          isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'role',
              'isVerified',
              'isBanned',
              'followersCount',
              'followingCount',
              'postsCount',
              'createdAt'
            ])
          && (!('email' in request.resource.data)
              || ('email' in resource.data))
          && validText(request.resource.data.displayName, 1, 50)
          && (!request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['username'])
              || ownsUsername(request.resource.data.username))
          && (!('bio' in request.resource.data)
              || validText(request.resource.data.bio, 0, 150))
          && (!('accountType' in request.resource.data)
              || request.resource.data.accountType in ['public', 'private'])
          && (!('pronouns' in request.resource.data)
              || validText(request.resource.data.pronouns, 0, 30))
          && (!('gender' in request.resource.data)
              || request.resource.data.gender in ['male', 'female', 'none'])
          && validSignupFields(request.resource.data)
        )
        // إدارة المستخدمين من لوحة الأدمن: حظر / توثيق / تغيير الدور (المالك فقط)
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isBanned', 'isVerified', 'role', 'updatedAt'])
          && request.resource.data.isBanned is bool
          && request.resource.data.isVerified is bool
          && request.resource.data.role in ['admin', 'moderator', 'user']
        )
        // عدّاد المنشورات: يزيد/ينقص عند النشر والحذف (صاحب الحساب أو الأدمن)
        || (
          (isOwner(uid) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['postsCount'])
          && request.resource.data.postsCount is int
          && request.resource.data.postsCount >= 0
        );

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- 1-ب. حجز أسماء المستخدمين (الإصلاح) ----------
    // معرّف الوثيقة = اسم المستخدم نفسه، وتحمل uid صاحبه
    match /usernames/{uname} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && uname.size() >= 3
        && uname.size() <= 30
        && uname.matches('^[a-z0-9_]+(\\.[a-z0-9_]+)*$');

      allow update: if false;

      // اسم المالك محمي: لا يمكن حذفه أو تحريره حتى لا يستولي عليه أحد
      allow delete: if signedIn()
        && uname != 'animeverse_official'
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- 2. البيانات الخاصة ----------
    match /userPrivate/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
        && validText(request.resource.data.email, 3, 254)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- 3. مفاتيح التشفير العامة ----------
    match /publicKeys/{uid} {
      allow read: if signedIn();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'keyId',
          'publicKey',
          'updatedAt'
        ])
        && validText(request.resource.data.keyId, 8, 64)
        && validText(request.resource.data.publicKey, 40, 400)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid) || isAdmin();
    }

    // نسخة المفتاح الخاص المشفرة
    match /keyBackups/{uid} {
      allow read, delete: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'keyId',
          'salt',
          'iv',
          'ciphertext',
          'iterations',
          'updatedAt'
        ])
        && validText(request.resource.data.keyId, 8, 64)
        && validText(request.resource.data.salt, 16, 64)
        && validText(request.resource.data.iv, 8, 64)
        && validText(request.resource.data.ciphertext, 40, 2000)
        && request.resource.data.iterations is int
        && request.resource.data.iterations >= 100000
        && request.resource.data.iterations <= 2000000
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- 4. المنشورات ----------
    match /posts/{postId} {
      allow read: if true;

      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'content',
          'mediaUrl',
          'mediaType',
          'likesCount',
          'commentsCount',
          'createdAt',
          'repostOfId',
          'repostOfAuthorId',
          'mentions',
          'collaborators'
        ])
        && validText(request.resource.data.authorName, 1, 50)
        && validText(request.resource.data.content, 0, 2000)
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.createdAt == request.time
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && (!('repostOfId' in request.resource.data)
            || validText(request.resource.data.repostOfId, 1, 100))
        && (!('repostOfAuthorId' in request.resource.data)
            || validText(request.resource.data.repostOfAuthorId, 1, 100))
        && (!('mentions' in request.resource.data)
            || (request.resource.data.mentions is list
                && request.resource.data.mentions.size() <= 20))
        && (!('collaborators' in request.resource.data)
            || (request.resource.data.collaborators is list
                && request.resource.data.collaborators.size() <= 10))
        && (!('mediaUrl' in request.resource.data)
            || request.resource.data.mediaUrl == ''
            || request.resource.data.mediaUrl.matches(
              'https://res\\.cloudinary\\.com/.*'
            ))
        && (!('mediaType' in request.resource.data)
            || request.resource.data.mediaType in ['image', 'video'])
        && (
          request.resource.data.content.size() > 0
          || (
            'mediaUrl' in request.resource.data
            && request.resource.data.mediaUrl != ''
          )
        );

      allow update: if signedIn() && (
        (
          request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['content'])
          && validText(request.resource.data.content, 0, 2000)
        )
        || isAdmin()
        || (
          !isBanned()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likesCount'])
          && request.resource.data.likesCount >= 0
          && (
            // إعجاب جديد: وثيقة الإعجاب لم تكن موجودة وتُنشأ الآن
            (
              request.resource.data.likesCount == resource.data.likesCount + 1
              && !exists(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
              && existsAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
            )
            ||
            // إلغاء إعجاب: وثيقة الإعجاب موجودة وتُحذف الآن
            (
              request.resource.data.likesCount == resource.data.likesCount - 1
              && exists(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
            )
          )
        )
        || (
          !isBanned()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount >= 0
          && math.abs(
            request.resource.data.commentsCount - resource.data.commentsCount
          ) == 1
        )
      );

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
        );
    }

    // ---------- 5. القصص ----------
    match /stories/{storyId} {
      allow read: if signedIn();

      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'mediaUrl',
          'mediaType',
          'caption',
          'createdAt'
        ])
        && validText(request.resource.data.authorName, 1, 50)
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.matches(
          'https://res\\.cloudinary\\.com/.*'
        )
        && request.resource.data.mediaType in ['image', 'video']
        && (!('caption' in request.resource.data)
            || validText(request.resource.data.caption, 0, 200))
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
        );
    }

    // ---------- 5-ب. مشاهدات القصص والتفاعل معها ----------
    match /storyViews/{viewId} {
      allow get: if signedIn()
        && (
          viewId.matches('^.+_' + request.auth.uid + '$')
          || resource.data.authorId == request.auth.uid
        );

      allow list: if signedIn()
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.viewerId == request.auth.uid
        );

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'storyId',
          'authorId',
          'viewerId',
          'liked',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'storyId',
          'authorId',
          'viewerId',
          'liked',
          'createdAt'
        ])
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.authorId != request.auth.uid
        && viewId == request.resource.data.storyId + '_' + request.auth.uid
        && request.resource.data.liked == false
        && request.resource.data.createdAt == request.time
        && exists(
          /databases/$(database)/documents/stories/$(request.resource.data.storyId)
        )
        && get(
          /databases/$(database)/documents/stories/$(request.resource.data.storyId)
        ).data.authorId == request.resource.data.authorId;

      allow update: if signedIn()
        && !isBanned()
        && resource.data.viewerId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['liked', 'reply', 'updatedAt'])
        && request.resource.data.liked is bool
        && (!('reply' in request.resource.data)
            || validText(request.resource.data.reply, 1, 200))
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && (
          resource.data.viewerId == request.auth.uid
          || resource.data.authorId == request.auth.uid
        );
    }

    // ---------- 6. الإعجابات ----------
    match /likes/{likeId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'postId',
          'userId',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        );

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 6-ب. نشاط الأصدقاء (ريلز أعجب بها الأصدقاء) ----------
    // audience = قائمة الأصدقاء (متابعة متبادلة) الذين يحق لهم رؤية الإعجاب.
    // عند إيقاف "إظهار الإعجابات للأصدقاء" لا تُنشأ هذه الوثائق وتُحذف القديمة.
    match /friendActivity/{actId} {
      allow read: if signedIn()
        && (
          request.auth.uid in resource.data.audience
          || resource.data.userId == request.auth.uid
        );

      allow create, update: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'userId',
          'postId',
          'audience',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && actId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.audience is list
        && request.resource.data.audience.size() <= 500
        && request.resource.data.createdAt == request.time;

      allow delete: if signedIn()
        && (
          resource == null
          || resource.data.userId == request.auth.uid
        );
    }

    // ---------- 7. المتابعات ----------
    match /follows/{followId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'followerId',
          'followingId',
          'createdAt'
        ])
        && request.resource.data.followerId != request.resource.data.followingId
        && followId == request.resource.data.followerId
          + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time
        && (
          (
            request.auth.uid == request.resource.data.followerId
            && !isBlockedBy(request.resource.data.followingId)
            && get(
              /databases/$(database)/documents/users/$(request.resource.data.followingId)
            ).data.accountType == 'public'
          )
          ||
          (
            request.auth.uid == request.resource.data.followingId
            && exists(
              /databases/$(database)/documents/followRequests/$(followId)
            )
          )
        );

      allow delete: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );
    }

    // طلبات متابعة الحسابات الخاصة
    match /followRequests/{reqId} {
      allow read: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'followerId',
          'followingId',
          'createdAt'
        ])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid
        && reqId == request.auth.uid
          + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time
        && !isBlockedBy(request.resource.data.followingId)
        && get(
          /databases/$(database)/documents/users/$(request.resource.data.followingId)
        ).data.accountType == 'private';

      allow delete: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );
    }

    // ---------- 8. الحظر ----------
    match /blocks/{blockId} {
      allow read: if signedIn()
        && resource.data.blockerId == request.auth.uid;

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'blockerId',
          'blockedId',
          'createdAt'
        ])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.createdAt == request.time;

      allow delete: if signedIn()
        && resource.data.blockerId == request.auth.uid;
    }

    // ---------- 9. البلاغات ----------
    match /reports/{reportId} {
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'type',
          'targetId',
          'targetType',
          'reporterUid',
          'reason',
          'status',
          'createdAt'
        ])
        && request.resource.data.type in ['broken-link', 'abuse', 'spam', 'bug']
        && request.resource.data.targetType in [
          'episode',
          'comment',
          'post',
          'user',
          'app'
        ]
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validText(request.resource.data.targetId, 1, 200)
        && validText(request.resource.data.reason, 1, 500)
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // ---------- 10. المحادثات ----------
    match /conversations/{convId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && !isBanned()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && (
          (
            (!('type' in request.resource.data) || request.resource.data.type == 'direct')
            && request.resource.data.members.size() == 2
            && request.resource.data.members[0] < request.resource.data.members[1]
            && convId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
            && !isBlockedBy(otherOf(request.resource.data.members))
          )
          ||
          (
            request.resource.data.type == 'group'
            && request.resource.data.members.size() >= 2
            && request.resource.data.members.size() <= 100
            && validText(request.resource.data.name, 1, 50)
            && request.auth.uid in request.resource.data.admins
          )
        );

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageBy'])
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.lastMessageBy == request.auth.uid
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
            && request.resource.data.reads[request.auth.uid] == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme'])
            && request.resource.data.theme is string
            && request.resource.data.theme.size() <= 30
          )
          ||
          (
            // الرسائل المؤقتة: مدة بالميلي ثانية (0 = معطّلة)
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disappearAfter'])
            && request.resource.data.disappearAfter is int
            && request.resource.data.disappearAfter >= 0
            && request.resource.data.disappearAfter <= 31536000000
          )
          ||
          (
            resource.data.type == 'group'
            && request.auth.uid in resource.data.admins
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'admins'])
          )
        );

      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in convMembers(convId);

        allow create: if signedIn()
          && !isBanned()
          && request.auth.uid in convMembers(convId)
          && notHardBlocked(convId)
          && request.resource.data.keys().hasOnly(['senderId','ciphertext','iv','senderKeyId','recipientKeyId','createdAt','replyTo','reactions','wraps'])
          && (!('wraps' in request.resource.data) || request.resource.data.wraps is map)
          && request.resource.data.senderId == request.auth.uid
          && validText(request.resource.data.ciphertext, 1, 20000)
          && validText(request.resource.data.iv, 8, 64)
          && validText(request.resource.data.senderKeyId, 8, 64)
          && validText(request.resource.data.recipientKeyId, 8, 64)
          && request.resource.data.createdAt == request.time
          && (!('replyTo' in request.resource.data) || validText(request.resource.data.replyTo, 1, 100));

        allow update: if signedIn()
          && request.auth.uid in convMembers(convId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map;

        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ---------- 10-أ. إعدادات المحادثة الشخصية (كتم / تقييد) ----------
    match /chatPrefs/{prefId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create, update: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'convId',
          'muted',
          'restricted',
          'updatedAt'
        ])
        && validText(request.resource.data.convId, 1, 200)
        && prefId == request.resource.data.userId + '_' + request.resource.data.convId
        && request.resource.data.muted is bool
        && request.resource.data.restricted is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 10-ب. الملاحظات ----------
    match /notes/{noteUid} {
      allow read: if signedIn();

      allow create, update: if isOwner(noteUid)
        && !isBanned()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
        && request.resource.data.uid == noteUid
        && validText(request.resource.data.text, 1, 60)
        && request.resource.data.createdAt == request.time;

      allow delete: if isOwner(noteUid) || isAdmin();
    }

    // ---------- 11. الحلقات والسيرفرات ----------
    match /episodes/{episodeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /servers/{serverId} {
        allow read: if true;

        allow create, update: if isAdmin()
          && validText(request.resource.data.name, 1, 50)
          && validText(request.resource.data.link, 1, 1000)
          && request.resource.data.link.matches('^https?://.*')
          && (!('quality' in request.resource.data)
              || validText(request.resource.data.quality, 1, 20));

        allow delete: if isAdmin();
      }
    }

    // ---------- 12. التعليقات ----------
    match /comments/{commentId} {
      allow read: if signedIn();

      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'postId',
          'authorId',
          'authorName',
          'authorPhotoURL',
          'content',
          'createdAt'
        ])
        && request.resource.data.postId is string
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        )
        && validText(request.resource.data.authorName, 1, 50)
        && validText(request.resource.data.content, 1, 500)
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
        );
    }

    // ---------- 13. الإشعارات ----------
    match /notifications/{nid} {
      allow read: if signedIn()
        && resource.data.toUid == request.auth.uid;

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'toUid',
          'fromUid',
          'fromName',
          'fromPhotoURL',
          'type',
          'text',
          'read',
          'createdAt',
          'postId'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.type in [
          'like',
          'comment',
          'follow',
          'request',
          'new_device'
        ]
        && validText(request.resource.data.fromName, 1, 50)
        && validText(request.resource.data.text, 0, 200)
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.type == 'new_device'
            && request.resource.data.toUid == request.auth.uid
          )
          ||
          (
            request.resource.data.type != 'new_device'
            && request.resource.data.toUid != request.auth.uid
            && validText(request.resource.data.toUid, 1, 128)
            && !isBlockedBy(request.resource.data.toUid)
          )
        )
        && (
          !('fromPhotoURL' in request.resource.data)
          || request.resource.data.fromPhotoURL is string
        )
        && (
          !('postId' in request.resource.data)
          || request.resource.data.postId is string
        );

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if signedIn()
        && resource.data.toUid == request.auth.uid;
    }

    // ---------- 14. الأجهزة المسجلة ----------
    match /userDevices/{uid}/items/{deviceId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && !isBanned()
        && validText(deviceId, 1, 100)
        && request.resource.data.keys().hasOnly([
          'label',
          'platform',
          'createdAt'
        ])
        && validText(request.resource.data.label, 1, 40)
        && request.resource.data.platform in ['android', 'web']
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if isOwner(uid);
    }

    // ---------- 15. المكتبة الشخصية ----------
    match /library/{itemId} {
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow create, update: if signedIn()
        && !isBanned()
        && request.resource.data.userId == request.auth.uid
        && itemId == request.auth.uid + '_'
          + request.resource.data.animeId;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 16. تقييمات الحلقات ----------
    match /episodeRatings/{ratingId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'episodeKey',
          'userId',
          'rating',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && ratingId == request.resource.data.episodeKey
          + '_' + request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 17. أنمي خاص ----------
    match /customAnime/{animeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 18. الإعلانات ----------
    match /announcements/{annId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- 19. سجل الإدارة ----------
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- 20. زيارات الملفات الشخصية (للإحصائيات) ----------
    match /profileViews/{viewId} {
      allow read: if signedIn()
        && (resource.data.profileUid == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'profileUid',
          'viewerId',
          'day',
          'createdAt'
        ])
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.profileUid is string
        && request.resource.data.profileUid != request.auth.uid
        && request.resource.data.day is string
        && request.resource.data.day.size() == 8
        && request.resource.data.createdAt == request.time
        && viewId == request.resource.data.profileUid + '_' + request.auth.uid + '_' + request.resource.data.day;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // أي مسار غير مذكور مرفوض افتراضياً.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
