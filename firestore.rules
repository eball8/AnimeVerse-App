rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- الدوال المساعدة ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // المالك الأساسي: صاحب حجز اسم المستخدم animeverse_official[span_1](start_span)[span_1](end_span)
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/usernames/animeverse_official)
             .data.get('uid', '') == request.auth.uid;
    }

    function isBanned() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('isBanned', false) == true;
    }

    function validText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function validSignupFields(d) {
      return (!('firstName' in d) || validText(d.firstName, 1, 25))
        && (!('lastName' in d) || validText(d.lastName, 1, 25))
        && (!('gender' in d) || d.gender in ['male', 'female', 'none'])
        && (!('birthDate' in d)
            || (d.birthDate is string
                && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('age' in d) || (d.age is int && d.age >= 13 && d.age <= 120));
    }

    function ownsUsername(uname) {
      return uname is string
        && getAfter(/databases/$(database)/documents/usernames/$(uname))
             .data.get('uid', '') == request.auth.uid;
    }

    function isBlockedBy(otherUid) {
      return exists(
        /databases/$(database)/documents/blocks/$(otherUid + '_' + request.auth.uid)
      );
    }

    function isBlockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    function convData(convId) {
      return get(
        /databases/$(database)/documents/conversations/$(convId)
      ).data;
    }

    function isGroupConv(convId) {
      return convData(convId).get('type', 'direct') == 'group';
    }

    function notHardBlocked(convId) {
      return isGroupConv(convId)
        || !isBlockedEitherWay(
          request.auth.uid,
          otherOf(convData(convId).members)
        );
    }

    function convMembers(convId) {
      return get(
        /databases/$(database)/documents/conversations/$(convId)
      ).data.members;
    }

    function otherOf(members) {
      return members[0] == request.auth.uid
        ? members[1]
        : members[0];
    }

    function canMessageOther(otherUid) {
      let otherData = get(/databases/$(database)/documents/users/$(otherUid)).data;
      let privacy = otherData.get('messagePrivacy', 'everyone');
      return privacy == 'everyone'
        || (privacy == 'following' && exists(/databases/$(database)/documents/follows/$(otherUid + '_' + request.auth.uid)));
    }

    // ---------- 1. ملفات المستخدمين العامة ----------[span_2](start_span)[span_2](end_span)
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && !('email' in request.resource.data)
        && request.resource.data.role == 'user'
        && request.resource.data.isVerified == false
        && request.resource.data.isBanned == false
        && request.resource.data.followersCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.postsCount == 0
        && request.resource.data.accountType in ['public', 'private']
        && validText(request.resource.data.displayName, 1, 50)
        && validText(request.resource.data.username, 3, 30)
        && ownsUsername(request.resource.data.username)
        && validSignupFields(request.resource.data);

      allow update: if (
          isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'role',
              'isVerified',
              'isBanned',
              'followersCount',
              'followingCount',
              'postsCount',
              'createdAt'
            ])
          && (!('email' in request.resource.data)
              || ('email' in resource.data))
          && validText(request.resource.data.displayName, 1, 50)
          && (!request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['username'])
              || ownsUsername(request.resource.data.username))
          && (!('bio' in request.resource.data)
              || validText(request.resource.data.bio, 0, 150))
          && (!('accountType' in request.resource.data)
              || request.resource.data.accountType in ['public', 'private'])
          && (!('pronouns' in request.resource.data)
              || validText(request.resource.data.pronouns, 0, 30))
          && (!('gender' in request.resource.data)
              || request.resource.data.gender in ['male', 'female', 'none'])
          && validSignupFields(request.resource.data)
        )
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isBanned', 'isVerified', 'role', 'updatedAt'])
          && request.resource.data.isBanned is bool
          && request.resource.data.isVerified is bool
          && request.resource.data.role in ['admin', 'moderator', 'user']
        )
        || (
          (isOwner(uid) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['postsCount'])
          && request.resource.data.postsCount is int
          && request.resource.data.postsCount >= 0
        );

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- 1-ب. حجز أسماء المستخدمين ----------[span_3](start_span)[span_3](end_span)
    match /usernames/{uname} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && uname.size() >= 3
        && uname.size() <= 30
        && uname.matches('^[a-z0-9_]+(\\.[a-z0-9_]+)*$');

      allow update: if false;

      allow delete: if signedIn()
        && uname != 'animeverse_official'
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- 2. البيانات الخاصة ----------[span_4](start_span)[span_4](end_span)
    match /userPrivate/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
        && validText(request.resource.data.email, 3, 254)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- 3. مفاتيح التشفير العامة ----------[span_5](start_span)[span_5](end_span)
    match /publicKeys/{uid} {
      allow read: if signedIn();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'keyId',
          'publicKey',
          'updatedAt'
        ])
        && validText(request.resource.data.keyId, 8, 64)
        && validText(request.resource.data.publicKey, 40, 400)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid) || isAdmin();
    }

    match /keyBackups/{uid} {
      allow read, delete: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'keyId',
          'salt',
          'iv',
          'ciphertext',
          'iterations',
          'updatedAt'
        ])
        && validText(request.resource.data.keyId, 8, 64)
        && validText(request.resource.data.salt, 16, 64)
        && validText(request.resource.data.iv, 8, 64)
        && validText(request.resource.data.ciphertext, 40, 2000)
        && request.resource.data.iterations is int
        && request.resource.data.iterations >= 100000
        && request.resource.data.iterations <= 2000000
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- 4. المنشورات ----------[span_6](start_span)[span_6](end_span)
    match /posts/{postId} {
      allow get: if resource == null
        || resource.data.get('repostOfId', null) == null
        || (signedIn()
            && (request.auth.uid == resource.data.authorId
                || (exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + resource.data.authorId))
                    && exists(/databases/$(database)/documents/follows/$(resource.data.authorId + '_' + request.auth.uid)))
                || isAdmin()));
      allow list: if true;

      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'content',
          'mediaUrl',
          'mediaType',
          'likesCount',
          'commentsCount',
          'createdAt',
          'repostOfId',
          'repostOfAuthorId',
          'mentions',
          'collaborators',
          'allowAudio',
          'audioSourceId',
          'audioUrl'
        ])
        && validText(request.resource.data.authorName, 1, 50)
        && validText(request.resource.data.content, 0, 2000)
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.createdAt == request.time
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && (!('repostOfId' in request.resource.data)
            || validText(request.resource.data.repostOfId, 1, 100))
        && (!('repostOfAuthorId' in request.resource.data)
            || validText(request.resource.data.repostOfAuthorId, 1, 100))
        && (!('mentions' in request.resource.data)
            || (request.resource.data.mentions is list
                && request.resource.data.mentions.size() <= 20))
        && (!('collaborators' in request.resource.data)
            || (request.resource.data.collaborators is list
                && request.resource.data.collaborators.size() <= 4
                && request.resource.data.collaborators.toSet().size()
                   == request.resource.data.collaborators.size()
                && !request.resource.data.collaborators.hasAny([request.auth.uid])))
        && (!('mediaUrl' in request.resource.data)
            || request.resource.data.mediaUrl == ''
            || request.resource.data.mediaUrl.matches(
              'https://res\\.cloudinary\\.com/.*'
            ))
        && (!('mediaType' in request.resource.data)
            || request.resource.data.mediaType in ['image', 'video'])
        && (!('allowAudio' in request.resource.data)
            || (request.resource.data.allowAudio is bool
                && request.resource.data.get('mediaType', '') == 'video'))
        && (!('audioUrl' in request.resource.data)
            || 'audioSourceId' in request.resource.data)
        && (!('audioSourceId' in request.resource.data)
            || (
              validText(request.resource.data.audioSourceId, 1, 100)
              && request.resource.data.get('mediaType', '') == 'video'
              && request.resource.data.get('allowAudio', false) == false
              && get(/databases/$(database)/documents/posts/$(request.resource.data.audioSourceId))
                   .data.get('allowAudio', false) == true
              && request.resource.data.get('audioUrl', '') ==
                 get(/databases/$(database)/documents/posts/$(request.resource.data.audioSourceId))
                   .data.get('mediaUrl', '')
            ))
        && (
          request.resource.data.content.size() > 0
          || (
            'mediaUrl' in request.resource.data
            && request.resource.data.mediaUrl != ''
          )
        );

      allow update: if signedIn() && (
        (
          request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['content', 'allowAudio'])
          && validText(request.resource.data.content, 0, 2000)
          && (
            !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['allowAudio'])
            || (
              request.resource.data.allowAudio is bool
              && resource.data.get('mediaType', '') == 'video'
              && !('audioSourceId' in resource.data)
              && !('repostOfId' in resource.data)
            )
          )
        )
        || isAdmin()
        || (
          !isBanned()
          && resource.data.get('collaborators', []).hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['collaborators', 'collabAccepted'])
          && request.resource.data.get('collaborators', []) is list
          && request.resource.data.get('collabAccepted', []) is list
          && request.resource.data.get('collaborators', []).toSet()
               .difference(resource.data.get('collaborators', []).toSet()).size() == 0
          && resource.data.get('collaborators', []).toSet()
               .difference(request.resource.data.get('collaborators', []).toSet())
               .hasOnly([request.auth.uid])
          && request.resource.data.get('collabAccepted', []).toSet()
               .difference(request.resource.data.get('collaborators', []).toSet()).size() == 0
          && request.resource.data.get('collabAccepted', []).toSet()
               .difference(resource.data.get('collabAccepted', []).toSet())
               .hasOnly([request.auth.uid])
        )
        || (
          !isBanned()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likesCount'])
          && request.resource.data.likesCount >= 0
          && (
            (
              request.resource.data.likesCount == resource.data.likesCount + 1
              && !exists(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
              && existsAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
            )
            ||
            (
              request.resource.data.likesCount == resource.data.likesCount - 1
              && exists(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
            )
          )
        )
        || (
          !isBanned()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount >= 0
          && request.resource.data.commentsCount != resource.data.commentsCount
          && request.resource.data.commentsCount - resource.data.commentsCount <= 1
          && request.resource.data.commentsCount - resource.data.commentsCount >= -10
        )
      );

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
        );
    }

    // ---------- 5. القصص ----------[span_7](start_span)[span_7](end_span)
    match /stories/{storyId} {
      allow read: if signedIn();

      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'mediaUrl',
          'mediaType',
          'caption',
          'createdAt'
        ])
        && validText(request.resource.data.authorName, 1, 50)
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.matches(
          'https://res\\.cloudinary\\.com/.*'
        )
        && request.resource.data.mediaType in ['image', 'video']
        && (!('caption' in request.resource.data)
            || validText(request.resource.data.caption, 0, 200))
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
        );
    }

    // ---------- 5-ب. مشاهدات القصص ----------[span_8](start_span)[span_8](end_span)
    match /storyViews/{viewId} {
      allow get: if signedIn()
        && (
          viewId.matches('^.+_' + request.auth.uid + '$')
          || resource.data.authorId == request.auth.uid
        );

      allow list: if signedIn()
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.viewerId == request.auth.uid
        );

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'storyId',
          'authorId',
          'viewerId',
          'liked',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'storyId',
          'authorId',
          'viewerId',
          'liked',
          'createdAt'
        ])
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.authorId != request.auth.uid
        && viewId == request.resource.data.storyId + '_' + request.auth.uid
        && request.resource.data.liked == false
        && request.resource.data.createdAt == request.time
        && exists(
          /databases/$(database)/documents/stories/$(request.resource.data.storyId)
        )
        && get(
          /databases/$(database)/documents/stories/$(request.resource.data.storyId)
        ).data.authorId == request.resource.data.authorId;

      allow update: if signedIn()
        && !isBanned()
        && resource.data.viewerId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['liked', 'reply', 'updatedAt'])
        && request.resource.data.liked is bool
        && (!('reply' in request.resource.data)
            || validText(request.resource.data.reply, 1, 200))
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && (
          resource.data.viewerId == request.auth.uid
          || resource.data.authorId == request.auth.uid
        );
    }

    // ---------- 6. الإعجابات ----------[span_9](start_span)[span_9](end_span)
    match /likes/{likeId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'postId',
          'userId',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        );

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 6-ب. نشاط الأصدقاء ----------[span_10](start_span)[span_10](end_span)
    match /friendActivity/{actId} {
      allow read: if signedIn()
        && (
          request.auth.uid in resource.data.audience
          || resource.data.userId == request.auth.uid
        );

      allow create, update: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'userId',
          'postId',
          'audience',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && actId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.audience is list
        && request.resource.data.audience.size() <= 500
        && request.resource.data.createdAt == request.time;

      allow delete: if signedIn()
        && (
          resource == null
          || resource.data.userId == request.auth.uid
        );
    }

    // ---------- 7. المتابعات ----------[span_11](start_span)[span_11](end_span)
    match /follows/{followId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'followerId',
          'followingId',
          'createdAt'
        ])
        && request.resource.data.followerId != request.resource.data.followingId
        && followId == request.resource.data.followerId
          + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time
        && (
          (
            request.auth.uid == request.resource.data.followerId
            && !isBlockedBy(request.resource.data.followingId)
            && get(
              /databases/$(database)/documents/users/$(request.resource.data.followingId)
            ).data.accountType == 'public'
          )
          ||
          (
            request.auth.uid == request.resource.data.followingId
            && exists(
              /databases/$(database)/documents/followRequests/$(followId)
            )
          )
        );

      allow delete: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );
    }

    match /followRequests/{reqId} {
      allow read: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'followerId',
          'followingId',
          'createdAt'
        ])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid
        && reqId == request.auth.uid
          + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time
        && !isBlockedBy(request.resource.data.followingId)
        && get(
          /databases/$(database)/documents/users/$(request.resource.data.followingId)
        ).data.accountType == 'private';

      allow delete: if signedIn()
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followingId == request.auth.uid
        );
    }

    // ---------- 8. الحظر ----------[span_12](start_span)[span_12](end_span)
    match /blocks/{blockId} {
      allow read: if signedIn()
        && resource.data.blockerId == request.auth.uid;

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'blockerId',
          'blockedId',
          'createdAt'
        ])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.createdAt == request.time;

      allow delete: if signedIn()
        && resource.data.blockerId == request.auth.uid;
    }

    // ---------- 9. البلاغات ----------[span_13](start_span)[span_13](end_span)
    match /reports/{reportId} {
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'type',
          'targetId',
          'targetType',
          'reason',
          'status',
          'createdAt',
          'category',
          'details',
          'reportedUid',
          'reportedUsername',
          'link',
          'screenshots',
          'contentType',
          'contactUsername',
          'appVersion'
        ])
        && request.resource.data.keys().hasAll([
          'type',
          'targetId',
          'targetType',
          'reason',
          'status',
          'createdAt'
        ])
        && request.resource.data.type in ['broken-link', 'abuse', 'spam', 'bug']
        && request.resource.data.targetType in [
          'episode',
          'comment',
          'post',
          'video',
          'reel',
          'story',
          'message',
          'conversation',
          'group',
          'user',
          'app'
        ]
        && request.resource.data.status == 'pending'
        && validText(request.resource.data.targetId, 1, 200)
        && validText(request.resource.data.reason, 1, 500)
        && request.resource.data.createdAt == request.time
        && (!('category' in request.resource.data)
            || validText(request.resource.data.category, 1, 40))
        && (!('details' in request.resource.data)
            || validText(request.resource.data.details, 1, 1000))
        && (!('reportedUid' in request.resource.data)
            || validText(request.resource.data.reportedUid, 1, 200))
        && (!('reportedUsername' in request.resource.data)
            || validText(request.resource.data.reportedUsername, 1, 60))
        && (!('link' in request.resource.data)
            || validText(request.resource.data.link, 1, 500))
        && (!('contentType' in request.resource.data)
            || request.resource.data.contentType in ['text', 'image', 'video', 'audio'])
        && (!('contactUsername' in request.resource.data)
            || validText(request.resource.data.contactUsername, 1, 60))
        && (!('appVersion' in request.resource.data)
            || validText(request.resource.data.appVersion, 1, 30))
        && (!('screenshots' in request.resource.data)
            || (request.resource.data.screenshots is list
                && request.resource.data.screenshots.size() <= 3));

      allow read, update, delete: if isAdmin();
    }

    // ---------- 10. المحادثات ----------[span_14](start_span)[span_14](end_span)
    match /conversations/{convId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && !isBanned()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && (
          (
            (!('type' in request.resource.data) || request.resource.data.type == 'direct')
            && request.resource.data.members.size() == 2
            && request.resource.data.members[0] < request.resource.data.members[1]
            && convId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
            && !isBlockedBy(otherOf(request.resource.data.members))
            && canMessageOther(otherOf(request.resource.data.members))
            && (!('starterId' in request.resource.data)
                || request.resource.data.starterId == request.auth.uid)
          )
          ||
          (
            request.resource.data.type == 'group'
            && request.resource.data.members.size() >= 2
            && request.resource.data.members.size() <= 100
            && validText(request.resource.data.name, 1, 50)
            && request.auth.uid in request.resource.data.admins
          )
        );

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageBy'])
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.lastMessageBy == request.auth.uid
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
            && request.resource.data.reads[request.auth.uid] == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme'])
            && request.resource.data.theme is string
            && request.resource.data.theme.size() <= 30
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disappearAfter'])
            && request.resource.data.disappearAfter is int
            && request.resource.data.disappearAfter >= 0
            && request.resource.data.disappearAfter <= 31536000000
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
            && request.resource.data.pinned is list
            && request.resource.data.pinned.size() <= 3
          )
          ||
          (
            resource.data.type == 'group'
            && request.auth.uid in resource.data.admins
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'admins'])
          )
        );

      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in convMembers(convId);

        allow create: if signedIn()
          && !isBanned()
          && request.auth.uid in convMembers(convId)
          && notHardBlocked(convId)
          && request.resource.data.keys().hasOnly(['senderId','ciphertext','iv','senderKeyId','recipientKeyId','createdAt','replyTo','reactions','wraps'])
          && (!('wraps' in request.resource.data) || request.resource.data.wraps is map)
          && request.resource.data.senderId == request.auth.uid
          && validText(request.resource.data.ciphertext, 1, 20000)
          && validText(request.resource.data.iv, 8, 64)
          && validText(request.resource.data.senderKeyId, 8, 64)
          && validText(request.resource.data.recipientKeyId, 8, 64)
          && request.resource.data.createdAt == request.time
          && (!('replyTo' in request.resource.data) || validText(request.resource.data.replyTo, 1, 100));

        allow update: if signedIn()
          && request.auth.uid in convMembers(convId)
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.reactions is map
            )
            ||
            (
              resource.data.senderId == request.auth.uid
              && request.resource.data.senderId == resource.data.senderId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ciphertext', 'iv', 'wraps', 'edited'])
              && validText(request.resource.data.ciphertext, 1, 20000)
              && validText(request.resource.data.iv, 8, 64)
              && request.resource.data.edited == true
              && (!('wraps' in request.resource.data) || request.resource.data.wraps is map)
            )
          );

        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ---------- 10-أ. إعدادات المحادثة الشخصية ----------[span_15](start_span)[span_15](end_span)
    match /chatPrefs/{prefId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create, update: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'convId',
          'muted',
          'restricted',
          'archived',
          'deletedAt',
          'pinnedAt',
          'accepted',
          'updatedAt'
        ])
        && validText(request.resource.data.convId, 1, 200)
        && prefId == request.resource.data.userId + '_' + request.resource.data.convId
        && request.resource.data.muted is bool
        && request.resource.data.restricted is bool
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool)
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt is int)
        && (!('pinnedAt' in request.resource.data) || request.resource.data.pinnedAt is int)
        && (!('accepted' in request.resource.data) || request.resource.data.accepted is bool)
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 10-ب. الملاحظات ----------[span_16](start_span)[span_16](end_span)
    match /notes/{noteUid} {
      allow read: if signedIn();

      allow create, update: if isOwner(noteUid)
        && !isBanned()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
        && request.resource.data.uid == noteUid
        && validText(request.resource.data.text, 1, 60)
        && request.resource.data.createdAt == request.time;

      allow delete: if isOwner(noteUid) || isAdmin();
    }

    // ---------- 11. الحلقات والسيرفرات ----------[span_17](start_span)[span_17](end_span)
    match /episodes/{episodeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /servers/{serverId} {
        allow read: if true;

        allow create, update: if isAdmin()
          && validText(request.resource.data.name, 1, 50)
          && validText(request.resource.data.link, 1, 1000)
          && request.resource.data.link.matches('^https?://.*')
          && (!('quality' in request.resource.data)
              || validText(request.resource.data.quality, 1, 20));

        allow delete: if isAdmin();
      }
    }

    // ---------- 12. التعليقات ----------[span_18](start_span)[span_18](end_span)
    match /comments/{commentId} {
      allow read: if signedIn();

      allow create: if isOwner(request.resource.data.authorId)
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'postId',
          'authorId',
          'authorName',
          'authorPhotoURL',
          'content',
          'createdAt',
          'parentId',
          'replyToUid',
          'replyToName'
        ])
        && request.resource.data.postId is string
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        )
        && validText(request.resource.data.authorName, 1, 50)
        && validText(request.resource.data.content, 1, 500)
        && (!('authorPhotoURL' in request.resource.data)
            || request.resource.data.authorPhotoURL is string)
        && request.resource.data.createdAt == request.time
        && (
          (
            !('parentId' in request.resource.data)
            && !('replyToUid' in request.resource.data)
            && !('replyToName' in request.resource.data)
          )
          ||
          (
            'parentId' in request.resource.data
            && request.resource.data.parentId is string
            && validText(request.resource.data.get('replyToUid', ''), 1, 128)
            && validText(request.resource.data.get('replyToName', ''), 1, 50)
            && exists(
              /databases/$(database)/documents/comments/$(request.resource.data.parentId)
            )
            && get(
              /databases/$(database)/documents/comments/$(request.resource.data.parentId)
            ).data.postId == request.resource.data.postId
            && !('parentId' in get(
              /databases/$(database)/documents/comments/$(request.resource.data.parentId)
            ).data)
          )
        );

      allow update: if signedIn()
        && !isBanned()
        && (
          (
            request.auth.uid == resource.data.authorId
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['content', 'edited', 'editedAt'])
            && validText(request.resource.data.content, 1, 500)
            && request.resource.data.edited == true
            && request.resource.data.editedAt == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['likedBy', 'likesCount'])
            && request.resource.data.likedBy is list
            && request.resource.data.likesCount is int
            && request.resource.data.likesCount >= 0
            && (
              (
                !(request.auth.uid in resource.data.get('likedBy', []))
                && request.resource.data.likedBy.size()
                     == resource.data.get('likedBy', []).size() + 1
                && request.resource.data.likedBy.toSet()
                     .difference(resource.data.get('likedBy', []).toSet())
                     .hasOnly([request.auth.uid])
                && request.resource.data.likesCount
                     == resource.data.get('likesCount', 0) + 1
              )
              ||
              (
                request.auth.uid in resource.data.get('likedBy', [])
                && request.resource.data.likedBy.size()
                     == resource.data.get('likedBy', []).size() - 1
                && resource.data.get('likedBy', []).toSet()
                     .difference(request.resource.data.likedBy.toSet())
                     .hasOnly([request.auth.uid])
                && request.resource.data.likesCount
                     == resource.data.get('likesCount', 0) - 1
              )
            )
          )
        );

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
          || (
            exists(/databases/$(database)/documents/posts/$(resource.data.postId))
            && get(/databases/$(database)/documents/posts/$(resource.data.postId))
                 .data.authorId == request.auth.uid
          )
          || (
            'parentId' in resource.data
            && exists(/databases/$(database)/documents/comments/$(resource.data.parentId))
            && get(/databases/$(database)/documents/comments/$(resource.data.parentId))
                 .data.authorId == request.auth.uid
          )
        );
    }

    // ---------- 13. الإشعارات ----------[span_19](start_span)[span_19](end_span)
    match /notifications/{nid} {
      allow read: if signedIn()
        && resource.data.toUid == request.auth.uid;

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'toUid',
          'fromUid',
          'fromName',
          'fromPhotoURL',
          'type',
          'text',
          'read',
          'createdAt',
          'postId'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.type in [
          'like',
          'comment',
          'follow',
          'request',
          'mention',
          'new_device'
        ]
        && validText(request.resource.data.fromName, 1, 50)
        && validText(request.resource.data.text, 0, 200)
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.type == 'new_device'
            && request.resource.data.toUid == request.auth.uid
          )
          ||
          (
            request.resource.data.type != 'new_device'
            && request.resource.data.toUid != request.auth.uid
            && validText(request.resource.data.toUid, 1, 128)
            && !isBlockedBy(request.resource.data.toUid)
          )
        )
        && (
          !('fromPhotoURL' in request.resource.data)
          || request.resource.data.fromPhotoURL is string
        )
        && (
          !('postId' in request.resource.data)
          || request.resource.data.postId is string
        );

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if signedIn()
        && resource.data.toUid == request.auth.uid;
    }

    // ---------- 14. الأجهزة المسجلة ----------[span_20](start_span)[span_20](end_span)
    match /userDevices/{uid}/items/{deviceId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && !isBanned()
        && validText(deviceId, 1, 100)
        && request.resource.data.keys().hasOnly([
          'label',
          'platform',
          'createdAt'
        ])
        && validText(request.resource.data.label, 1, 40)
        && request.resource.data.platform in ['android', 'web']
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if isOwner(uid);
    }

    // ---------- 15. المكتبة الشخصية ----------[span_21](start_span)[span_21](end_span)
    match /library/{itemId} {
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow create, update: if signedIn()
        && !isBanned()
        && request.resource.data.userId == request.auth.uid
        && itemId == request.auth.uid + '_'
          + request.resource.data.animeId;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 16. تقييمات الحلقات ----------[span_22](start_span)[span_22](end_span)
    match /episodeRatings/{ratingId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'episodeKey',
          'userId',
          'rating',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && ratingId == request.resource.data.episodeKey
          + '_' + request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- 17. أنمي خاص ----------[span_23](start_span)[span_23](end_span)
    match /customAnime/{animeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 18. الإعلانات ----------[span_24](start_span)[span_24](end_span)
    match /announcements/{annId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- 19. سجل الإدارة ----------[span_25](start_span)[span_25](end_span)
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- 20. زيارات الملفات الشخصية ----------[span_26](start_span)[span_26](end_span)
    match /profileViews/{viewId} {
      allow read: if signedIn()
        && (resource.data.profileUid == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
          'profileUid',
          'viewerId',
          'day',
          'createdAt'
        ])
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.profileUid is string
        && request.resource.data.profileUid != request.auth.uid
        && request.resource.data.day is string
        && request.resource.data.day.size() == 8
        && request.resource.data.createdAt == request.time
        && viewId == request.resource.data.profileUid + '_' + request.auth.uid + '_' + request.resource.data.day;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // القاعدة الافتراضية العامة لأي مسار غير مذكور[span_27](start_span)[span_27](end_span)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
